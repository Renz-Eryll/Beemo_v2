# Postgres (Neon). `vercel env pull .env.local` fills these from the Vercel project.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Lets Vercel Cron call /api/cron/demo to keep the demo apiary's data current
CRON_SECRET=
